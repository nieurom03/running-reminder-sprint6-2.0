# Register app at https://www.strava.com/settings/api
EXPO_PUBLIC_STRAVA_CLIENT_ID=YOUR_CLIENT_ID

# Optional for production OAuth. Must point to your own server/serverless token proxy.
# Never put STRAVA_CLIENT_SECRET in the React Native app.
EXPO_PUBLIC_STRAVA_TOKEN_PROXY_URL=https://your-domain.example.com/strava/token
